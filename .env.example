# Public URL used in emails, result slips, and QR codes.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43219

# Leave unset to use the local Postgres-compatible database in ./data/pglite.
# On Netlify, Netlify Database sets NETLIFY_DB_URL automatically.
# DATABASE_URL=postgres://user:password@localhost:5432/smartexam
# NETLIFY_DB_URL=

# Load the sample institutions, people, and exams into an empty hosted database.
# Local file databases seed themselves when empty.
SEED_DEMO=true

# Protects GET /api/cron/release in production. The hourly Netlify function sends this bearer token.
CRON_SECRET=

# OTP. Defaults: 10 minutes, 5 wrong attempts, then the code is dead.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Optional pepper mixed into the stored code hash.
OTP_PEPPER=
# dev  = always print codes in the server console (and ./data/otp-dev.log). Never call a provider.
# live = send through the providers below. Missing credentials fail the send.
# unset = live for a channel that has credentials, dev for a channel that does not.
OTP_DELIVERY=

# Email. EMAIL_PROVIDER=resend or smtp. If unset, Resend is used when RESEND_API_KEY is set, otherwise SMTP when SMTP_HOST is set.
EMAIL_PROVIDER=
RESEND_API_KEY=
RESEND_FROM=SmartExam <noreply@smartexam.et>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartExam <noreply@smartexam.et>

# SMS. SMS_PROVIDER=twilio or afromessage.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# AfroMessage: https://www.afromessage.com/developers
# GET https://api.afromessage.com/api/send?sender=&to=&message= with Authorization: Bearer <token>
AFROMESSAGE_TOKEN=
AFROMESSAGE_SENDER=SmartExam
AFROMESSAGE_IDENTIFIER=
AFROMESSAGE_API_URL=https://api.afromessage.com/api/send

# AI question drafts. Leave both keys empty to disable the feature; the page stays usable and explains that drafting is off.
# OPENAI_API_KEY uses https://api.openai.com/v1. AI_API_KEY plus AI_BASE_URL points at any compatible chat-completions API.
OPENAI_API_KEY=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
